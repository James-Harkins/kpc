<style>
body {
    display: flex;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
}

body::before {
    content: '';
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: url(<%= asset_path 'course_1.jpg' %>) center/cover no-repeat;
    z-index: -1;
}

.next-trip-cost {
    background-color: #fff;
    opacity: .9;
    padding: 30px;
    margin: 20px;
    color: black;
    border-radius: 10px;
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
    width: 90%;
    max-width: 1000px;
}

.next-trip-cost h1 { font-size: 50px; }
.next-trip-cost h2 { font-size: 35px; }
.next-trip-cost h3 { font-size: 25px; margin-bottom: 4px; }

table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
th, td { padding: 8px 12px; text-align: left; border: 1px solid #ccc; }
th { background-color: #f0f0f0; }

select {
    padding: 6px 10px;
    border: 1px solid #aaa;
    border-radius: 4px;
    font-size: 1em;
    width: 100%;
    box-sizing: border-box;
}

.btn-outline-primary-finances {
    margin: 10px 5px;
    background-color: white;
    opacity: .8;
    padding: 12px 20px;
    font-size: 1em;
    color: black !important;
    outline: 0 none !important;
    box-shadow: none !important;
    border-color: black !important;
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
    border-radius: 10px;
    cursor: pointer;
}
.btn-outline-primary-finances:hover { background-color: gray !important; }

.admin-badge {
    background-color: #6c757d;
    color: white;
    font-size: 0.7em;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 6px;
    vertical-align: middle;
}

.tier-0 { color: #6c757d; font-weight: bold; }
.tier-1 { color: #1e7e34; }
.tier-2 { color: #b8860b; }
.tier-3 { color: rgb(222, 74, 72); }
</style>

<div class="next-trip-cost">
    <h1>Bed Assignments: KPC <%= @trip.number %></h1>

    <% flash.each do |name, msg| %>
        <div class="alert" role="alert"><%= content_tag :div, msg, class: name %></div>
    <% end %>

    <%= button_to 'View Week Grid', bed_assignments_week_path, method: :get, params: { trip_id: @trip.id }, class: 'btn-outline-primary-finances' %>

    <h2>Suggested Priority Order</h2>
    <% if @trip.deposit_due_date.present? %>
        <p>Deposit deadline: <strong><%= @trip.deposit_due_date.strftime('%B %-d, %Y') %></strong>.
           Admins always pick first. Then Tier 1 met their 50% deposit by the deadline,
           Tier 2 met it late, Tier 3 haven't met it.
           Within a tier: most nights first, then earliest deposit, then earliest registration.</p>
    <% else %>
        <p>No deposit deadline is set for this trip — admins pick first, and any met deposit counts as Tier 1.</p>
    <% end %>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Golfer</th>
                <th>Nights</th>
                <th>Deposit</th>
                <th>Registered</th>
                <th>Current Bed</th>
                <% if @houses.any? %><th>Reserve All Week</th><% end %>
            </tr>
        </thead>
        <tbody>
            <% @priority.each_with_index do |golfer_trip, index| %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td>
                        <%= golfer_trip.golfer.nickname.strip.titleize %>
                        <% if golfer_trip.golfer.admin? %><span class="admin-badge">ADMIN</span><% end %>
                    </td>
                    <td><%= golfer_trip.nights_attending %></td>
                    <td class="tier-<%= golfer_trip.bed_priority_tier %>">
                        <% case golfer_trip.bed_priority_tier %>
                        <% when 0 %>
                            Admin &mdash; first pick
                        <% when 1 %>
                            Tier 1 &mdash; met <%= golfer_trip.deposit_met_at.strftime('%-m/%-d') %>
                        <% when 2 %>
                            Tier 2 &mdash; met late <%= golfer_trip.deposit_met_at.strftime('%-m/%-d') %>
                        <% else %>
                            Not met &mdash; $<%= golfer_trip.payments.sum(&:amount) %> of $<%= golfer_trip.deposit_amount %> paid
                        <% end %>
                    </td>
                    <td><%= golfer_trip.created_at.strftime('%-m/%-d') %></td>
                    <td>
                        <% if golfer_trip.bed %>
                            <%= golfer_trip.bed.house.name %> &mdash; <%= golfer_trip.bed.bedroom.name %> (<%= golfer_trip.bed.description %>)
                        <% else %>
                            &mdash;
                        <% end %>
                    </td>
                    <% if @houses.any? %>
                        <td style="text-align: center;">
                            <input type="checkbox" name="reserved_all_week[]" value="<%= golfer_trip.id %>" form="assignments-form" <%= 'checked' if golfer_trip.reserved_all_week? %>>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        </tbody>
    </table>
    <% if @houses.any? %>
        <p style="font-size: 0.85em; color: #555;">
            Check <strong>Reserve All Week</strong> to hold a golfer's bed every night, even nights they're away
            (e.g. an admin arriving mid-week). Unchecked golfers only hold their bed on the nights they attend,
            so someone else can take it the other nights. Save Assignments below to apply.
        </p>
    <% end %>

    <h2>Assignments</h2>
    <% if @houses.empty? %>
        <p>No houses have been added for this trip yet. A site admin can add one from the Houses page.</p>
    <% else %>
        <%= form_with url: bed_assignments_path, method: :patch, local: true, id: 'assignments-form' do %>
            <input type="hidden" name="trip_id" value="<%= @trip.id %>">
            <% @houses.each do |house| %>
                <h3><%= house.name %></h3>
                <table>
                    <thead>
                        <tr>
                            <th>Bedroom</th>
                            <th>Bed</th>
                            <th>Rank</th>
                            <th>Golfer(s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% house.bedrooms.each do |bedroom| %>
                            <% bedroom.beds.sort_by(&:rank).each do |bed| %>
                                <% occupants = bed.golfer_trips.to_a %>
                                <tr>
                                    <td><%= bedroom.name %></td>
                                    <td><%= bed.description %></td>
                                    <td><%= bed.rank %></td>
                                    <td>
                                        <% (1..bed.capacity).each do |slot| %>
                                            <select name="beds[<%= bed.id %>][]" data-bed-id="<%= bed.id %>" data-bed-rank="<%= bed.rank %>" data-slot="<%= slot %>">
                                                <option value="">&mdash; Unassigned &mdash;</option>
                                                <% @priority.each_with_index do |golfer_trip, index| %>
                                                    <option value="<%= golfer_trip.id %>" <%= 'selected' if occupants[slot - 1]&.id == golfer_trip.id %>>
                                                        #<%= index + 1 %> <%= golfer_trip.golfer.nickname.strip.titleize %><%= ' (admin)' if golfer_trip.golfer.admin? %>
                                                    </option>
                                                <% end %>
                                            </select>
                                        <% end %>
                                    </td>
                                </tr>
                            <% end %>
                        <% end %>
                    </tbody>
                </table>
            <% end %>
            <button type="button" class="btn-outline-primary-finances" onclick="autofillAssignments()">Autofill by Priority</button>
            <input type="submit" value="Save Assignments" class="btn-outline-primary-finances">
            <p style="font-size: 0.85em; color: #555;">
                Autofill gives each golfer their own bed &mdash; best bed to highest priority &mdash; then
                doubles the remaining golfers into the lowest-ranked shared beds. Nothing is saved
                until you click Save Assignments, so rearrange freely first.
            </p>
        <% end %>
    <% end %>

    <br>
    <%= button_to 'Dashboard', '/dashboard', method: :get, class: 'btn-outline-primary-finances' %>
</div>

<script>
function autofillAssignments() {
    var selects = Array.prototype.slice.call(document.querySelectorAll('select[data-bed-id]'));
    if (selects.length === 0) return;

    // Group slot selects by bed, keeping bed rank
    var beds = {};
    selects.forEach(function(select) {
        var id = select.dataset.bedId;
        if (!beds[id]) beds[id] = { rank: parseInt(select.dataset.bedRank, 10), slots: [] };
        beds[id].slots[parseInt(select.dataset.slot, 10) - 1] = select;
    });
    var bedList = Object.keys(beds).map(function(id) { return beds[id]; });

    // Golfer trip ids in priority order — the dropdown options are already sorted
    var golfers = Array.prototype.slice.call(selects[0].options)
        .map(function(option) { return option.value; })
        .filter(function(value) { return value !== ''; });

    selects.forEach(function(select) { select.value = ''; });

    // Pass 1: one golfer per bed, best bed (rank 1) to highest priority
    var next = 0;
    bedList.sort(function(a, b) { return a.rank - b.rank; });
    bedList.forEach(function(bed) {
        if (next < golfers.length) bed.slots[0].value = golfers[next++];
    });

    // Pass 2: double the remaining golfers into shared beds, worst rank first
    bedList.sort(function(a, b) { return b.rank - a.rank; });
    bedList.forEach(function(bed) {
        if (next < golfers.length && bed.slots.length > 1) bed.slots[1].value = golfers[next++];
    });
}
</script>
